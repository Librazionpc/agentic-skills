{
  "version": 1,
  "name": "payment_reminder_send",
  "description": "Controlled-write send of a repayment reminder using approved templates and channel rules.",
  "request_schema": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "type": "object",
    "required": ["customer_id", "channel", "message"],
    "properties": {
      "customer_id": { "type": "string" },
      "channel": { "type": "string", "enum": ["in_app", "email", "sms", "whatsapp", "phone"] },
      "message": { "type": "string", "minLength": 1 },
      "template_id": { "type": "string" }
    },
    "additionalProperties": false
  },
  "response_schema": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "type": "object",
    "required": ["ok"],
    "properties": {
      "ok": { "type": "boolean" },
      "message_id": { "type": "string" }
    },
    "additionalProperties": true
  },
  "errors": ["INVALID_INPUT", "FORBIDDEN", "RATE_LIMITED", "UPSTREAM_UNAVAILABLE"]
}

