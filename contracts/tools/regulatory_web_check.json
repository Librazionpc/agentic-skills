{
  "version": 1,
  "name": "regulatory_web_check",
  "description": "Read-only retrieval of current regulatory guidance from approved public sources (e.g., CBN). Runtime must enforce domain allowlist and caching. Output must be summarized and citation-friendly.",
  "request_schema": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "type": "object",
    "required": ["query"],
    "properties": {
      "query": { "type": "string", "minLength": 1 },
      "domains_allowlist": {
        "type": "array",
        "items": { "type": "string" },
        "description": "Optional runtime allowlist (e.g., [\"cbn.gov.ng\"])."
      },
      "max_results": { "type": "integer", "minimum": 1, "maximum": 10, "default": 5 }
    },
    "additionalProperties": false
  },
  "response_schema": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "type": "object",
    "required": ["results"],
    "properties": {
      "results": {
        "type": "array",
        "items": {
          "type": "object",
          "required": ["title", "source", "summary"],
          "properties": {
            "title": { "type": "string" },
            "source": { "type": "string" },
            "published_at": { "type": "string" },
            "summary": { "type": "string" }
          },
          "additionalProperties": true
        }
      }
    },
    "additionalProperties": true
  },
  "errors": ["INVALID_INPUT", "FORBIDDEN", "RATE_LIMITED", "UPSTREAM_UNAVAILABLE"]
}

