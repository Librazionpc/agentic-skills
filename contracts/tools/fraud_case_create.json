{
  "version": 1,
  "name": "fraud_case_create",
  "description": "Controlled-write creation of a fraud case for investigation. Not customer-visible; do not expose internal detection logic.",
  "request_schema": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "type": "object",
    "required": ["customer_id", "summary"],
    "properties": {
      "customer_id": { "type": "string" },
      "transaction_id": { "type": "string" },
      "summary": { "type": "string", "minLength": 1 },
      "signals": { "type": "array", "items": { "type": "string" } }
    },
    "additionalProperties": false
  },
  "response_schema": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "type": "object",
    "required": ["case_id", "status"],
    "properties": {
      "case_id": { "type": "string" },
      "status": { "type": "string", "enum": ["open", "queued_for_review"] }
    },
    "additionalProperties": true
  },
  "errors": ["INVALID_INPUT", "FORBIDDEN", "RATE_LIMITED"]
}

