{
  "version": 1,
  "name": "policy_retrieval",
  "description": "Read-only retrieval of policy text/summary by policy id. Returns citations/refs when possible.",
  "request_schema": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "type": "object",
    "required": ["policy_id"],
    "properties": {
      "policy_id": { "type": "string", "minLength": 1 }
    },
    "additionalProperties": false
  },
  "response_schema": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "type": "object",
    "required": ["policy_id", "content"],
    "properties": {
      "policy_id": { "type": "string" },
      "content": { "type": "string" },
      "source": { "type": "string" }
    },
    "additionalProperties": true
  },
  "errors": ["INVALID_INPUT", "NOT_FOUND", "FORBIDDEN", "UPSTREAM_UNAVAILABLE"]
}

