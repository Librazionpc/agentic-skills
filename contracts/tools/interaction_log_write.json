{
  "version": 1,
  "name": "interaction_log_write",
  "description": "Controlled-write append to customer interaction timeline (audit-friendly). Must redact secrets and sensitive identifiers.",
  "request_schema": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "type": "object",
    "required": ["customer_id", "entry"],
    "properties": {
      "customer_id": { "type": "string" },
      "entry": {
        "type": "object",
        "required": ["type", "summary", "at"],
        "properties": {
          "type": { "type": "string" },
          "summary": { "type": "string", "minLength": 1 },
          "at": { "type": "string", "format": "date-time" },
          "metadata": { "type": "object" }
        },
        "additionalProperties": true
      }
    },
    "additionalProperties": false
  },
  "response_schema": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "type": "object",
    "required": ["ok"],
    "properties": { "ok": { "type": "boolean" } },
    "additionalProperties": true
  },
  "errors": ["INVALID_INPUT", "FORBIDDEN", "RATE_LIMITED"]
}

