{
  "version": 1,
  "name": "bank_confirmation_check",
  "description": "Read-only confirmation check with bank/provider for final receipt/confirmation (customer-safe).",
  "request_schema": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "type": "object",
    "required": ["transaction_id"],
    "properties": {
      "transaction_id": { "type": "string", "minLength": 3 }
    },
    "additionalProperties": false
  },
  "response_schema": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "type": "object",
    "required": ["transaction_id", "result"],
    "properties": {
      "transaction_id": { "type": "string" },
      "result": { "type": "string", "enum": ["confirmed", "not_confirmed", "unknown"] },
      "provider_status": { "type": "string" },
      "notes": { "type": "string" }
    },
    "additionalProperties": true
  },
  "errors": ["INVALID_INPUT", "NOT_FOUND", "FORBIDDEN", "UPSTREAM_UNAVAILABLE"]
}

