{
  "version": 1,
  "name": "ticket_assign",
  "description": "Controlled-write assignment of a ticket to a team/queue/agent id (runtime enforces valid destinations).",
  "request_schema": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "type": "object",
    "required": ["ticket_id", "assignee"],
    "properties": {
      "ticket_id": { "type": "string" },
      "assignee": { "type": "string" }
    },
    "additionalProperties": false
  },
  "response_schema": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "type": "object",
    "required": ["ok"],
    "properties": { "ok": { "type": "boolean" } },
    "additionalProperties": true
  },
  "errors": ["INVALID_INPUT", "NOT_FOUND", "FORBIDDEN", "CONFLICT"]
}

