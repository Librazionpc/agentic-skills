{
  "version": 1,
  "name": "ticket_status_check",
  "description": "Read-only check of current ticket status, SLA timestamps, and owner.",
  "request_schema": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "type": "object",
    "required": ["ticket_id"],
    "properties": {
      "ticket_id": { "type": "string" }
    },
    "additionalProperties": false
  },
  "response_schema": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "type": "object",
    "required": ["ticket_id", "status"],
    "properties": {
      "ticket_id": { "type": "string" },
      "status": { "type": "string" },
      "owner": { "type": "string" },
      "last_updated_at": { "type": "string", "format": "date-time" },
      "sla_due_at": { "type": "string", "format": "date-time" }
    },
    "additionalProperties": true
  },
  "errors": ["INVALID_INPUT", "NOT_FOUND", "FORBIDDEN", "UPSTREAM_UNAVAILABLE"]
}

