{
  "version": 1,
  "name": "kyc_status_lookup",
  "description": "Read-only lookup of KYC verification status. Customer-safe fields only (no full ID numbers).",
  "request_schema": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "type": "object",
    "required": ["customer_id"],
    "properties": {
      "customer_id": { "type": "string" }
    },
    "additionalProperties": false
  },
  "response_schema": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "type": "object",
    "required": ["customer_id", "kyc_level", "status"],
    "properties": {
      "customer_id": { "type": "string" },
      "kyc_level": { "type": "string" },
      "status": { "type": "string", "enum": ["not_started", "pending", "verified", "failed", "restricted"] },
      "failure_reason": { "type": "string" },
      "last_updated_at": { "type": "string", "format": "date-time" }
    },
    "additionalProperties": true
  },
  "errors": ["INVALID_INPUT", "NOT_FOUND", "FORBIDDEN", "UPSTREAM_UNAVAILABLE"]
}

