{
  "version": 1,
  "name": "ticket_update",
  "description": "Controlled-write update to an existing ticket (status, fields, or notes).",
  "request_schema": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "type": "object",
    "required": ["ticket_id", "update"],
    "properties": {
      "ticket_id": { "type": "string" },
      "update": { "type": "object" }
    },
    "additionalProperties": false
  },
  "response_schema": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "type": "object",
    "required": ["ok"],
    "properties": { "ok": { "type": "boolean" } },
    "additionalProperties": true
  },
  "errors": ["INVALID_INPUT", "NOT_FOUND", "FORBIDDEN", "RATE_LIMITED", "CONFLICT"]
}

