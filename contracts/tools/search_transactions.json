{
  "version": 1,
  "name": "search_transactions",
  "description": "Read-only search of transactions for a customer with pagination. Returns masked/sanitized fields only.",
  "request_schema": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "type": "object",
    "required": ["customer_id"],
    "properties": {
      "customer_id": { "type": "string" },
      "service_type": { "type": "string" },
      "status": { "type": "string" },
      "from": { "type": "string", "format": "date-time" },
      "to": { "type": "string", "format": "date-time" },
      "limit": { "type": "integer", "minimum": 1, "maximum": 100, "default": 20 },
      "cursor": { "type": "string" }
    },
    "additionalProperties": false
  },
  "response_schema": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "type": "object",
    "required": ["items"],
    "properties": {
      "items": {
        "type": "array",
        "items": {
          "type": "object",
          "required": ["transaction_id", "status", "amount", "currency", "created_at"],
          "properties": {
            "transaction_id": { "type": "string" },
            "status": { "type": "string" },
            "service_type": { "type": "string" },
            "amount": { "type": "number" },
            "currency": { "type": "string" },
            "created_at": { "type": "string", "format": "date-time" }
          },
          "additionalProperties": true
        }
      },
      "next_cursor": { "type": "string" }
    },
    "additionalProperties": true
  },
  "errors": ["INVALID_INPUT", "FORBIDDEN", "RATE_LIMITED", "UPSTREAM_TIMEOUT", "UPSTREAM_UNAVAILABLE"]
}

