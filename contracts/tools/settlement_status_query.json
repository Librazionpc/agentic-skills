{
  "version": 1,
  "name": "settlement_status_query",
  "description": "Read-only query of settlement system state for a transaction (customer-safe).",
  "request_schema": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "type": "object",
    "required": ["transaction_id"],
    "properties": {
      "transaction_id": { "type": "string", "minLength": 3 }
    },
    "additionalProperties": false
  },
  "response_schema": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "type": "object",
    "required": ["transaction_id", "settlement_state"],
    "properties": {
      "transaction_id": { "type": "string" },
      "settlement_state": { "type": "string", "enum": ["not_applicable", "pending", "settled", "failed", "unknown"] },
      "last_updated_at": { "type": "string", "format": "date-time" },
      "notes": { "type": "string" }
    },
    "additionalProperties": true
  },
  "errors": ["INVALID_INPUT", "NOT_FOUND", "FORBIDDEN", "UPSTREAM_UNAVAILABLE"]
}

