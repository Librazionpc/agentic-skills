{
  "version": 1,
  "name": "knowledge_search",
  "description": "Read-only search over approved knowledge sources (RAG). Returns citations/ids, not raw internal docs.",
  "request_schema": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "type": "object",
    "required": ["query"],
    "properties": {
      "query": { "type": "string", "minLength": 1 },
      "top_k": { "type": "integer", "minimum": 1, "maximum": 20, "default": 5 }
    },
    "additionalProperties": false
  },
  "response_schema": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "type": "object",
    "required": ["results"],
    "properties": {
      "results": {
        "type": "array",
        "items": {
          "type": "object",
          "required": ["id", "title", "snippet"],
          "properties": {
            "id": { "type": "string" },
            "title": { "type": "string" },
            "snippet": { "type": "string" }
          },
          "additionalProperties": true
        }
      }
    },
    "additionalProperties": true
  },
  "errors": ["INVALID_INPUT", "RATE_LIMITED", "UPSTREAM_UNAVAILABLE"]
}

