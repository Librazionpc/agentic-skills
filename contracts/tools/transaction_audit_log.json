{
  "version": 1,
  "name": "transaction_audit_log",
  "description": "Read-only access to audit log entries for a transaction/action (for internal compliance use).",
  "request_schema": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "type": "object",
    "properties": {
      "transaction_id": { "type": "string" },
      "ticket_id": { "type": "string" },
      "limit": { "type": "integer", "minimum": 1, "maximum": 200, "default": 50 }
    },
    "additionalProperties": false
  },
  "response_schema": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "type": "object",
    "required": ["events"],
    "properties": {
      "events": {
        "type": "array",
        "items": {
          "type": "object",
          "required": ["at", "type"],
          "properties": {
            "at": { "type": "string", "format": "date-time" },
            "type": { "type": "string" },
            "summary": { "type": "string" }
          },
          "additionalProperties": true
        }
      }
    },
    "additionalProperties": true
  },
  "errors": ["INVALID_INPUT", "FORBIDDEN", "UPSTREAM_UNAVAILABLE"]
}

