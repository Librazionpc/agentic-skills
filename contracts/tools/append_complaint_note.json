{
  "version": 1,
  "name": "append_complaint_note",
  "description": "Controlled-write append a note to an existing complaint ticket. Note must be redacted and audit-friendly.",
  "request_schema": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "type": "object",
    "required": ["ticket_id", "note"],
    "properties": {
      "ticket_id": { "type": "string" },
      "note": { "type": "string", "minLength": 1 },
      "visibility": { "type": "string", "enum": ["internal", "customer_safe"], "default": "internal" }
    },
    "additionalProperties": false
  },
  "response_schema": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "type": "object",
    "required": ["ok"],
    "properties": {
      "ok": { "type": "boolean" }
    },
    "additionalProperties": true
  },
  "errors": ["INVALID_INPUT", "NOT_FOUND", "FORBIDDEN", "RATE_LIMITED"]
}

