{
  "version": 1,
  "name": "debt_status_check",
  "description": "Read-only check of outstanding balance, due dates, and delinquency status for a customer/loan. Customer-safe fields only.",
  "request_schema": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "type": "object",
    "required": ["customer_id"],
    "properties": {
      "customer_id": { "type": "string" },
      "loan_id": { "type": "string" }
    },
    "additionalProperties": false
  },
  "response_schema": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "type": "object",
    "required": ["customer_id", "status", "outstanding_amount", "currency"],
    "properties": {
      "customer_id": { "type": "string" },
      "loan_id": { "type": "string" },
      "status": { "type": "string", "enum": ["current", "due", "overdue", "delinquent", "charged_off", "unknown"] },
      "days_past_due": { "type": "integer", "minimum": 0 },
      "outstanding_amount": { "type": "number", "minimum": 0 },
      "currency": { "type": "string", "minLength": 3, "maxLength": 3 },
      "next_due_date": { "type": "string", "format": "date-time" },
      "last_payment_at": { "type": "string", "format": "date-time" }
    },
    "additionalProperties": true
  },
  "errors": ["INVALID_INPUT", "NOT_FOUND", "FORBIDDEN", "UPSTREAM_UNAVAILABLE"]
}

