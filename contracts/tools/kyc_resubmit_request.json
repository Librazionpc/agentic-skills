{
  "version": 1,
  "name": "kyc_resubmit_request",
  "description": "Controlled-write request to trigger a KYC resubmission/review process. Does not bypass KYC; policy enforced at runtime.",
  "request_schema": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "type": "object",
    "required": ["customer_id"],
    "properties": {
      "customer_id": { "type": "string" },
      "notes": { "type": "string" }
    },
    "additionalProperties": false
  },
  "response_schema": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "type": "object",
    "required": ["request_id", "status"],
    "properties": {
      "request_id": { "type": "string" },
      "status": { "type": "string", "enum": ["submitted", "queued_for_review"] }
    },
    "additionalProperties": true
  },
  "errors": ["INVALID_INPUT", "FORBIDDEN", "RATE_LIMITED", "CONFLICT"]
}

