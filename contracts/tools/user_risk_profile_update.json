{
  "version": 1,
  "name": "user_risk_profile_update",
  "description": "Controlled-write update of internal risk profile markers for compliance workflows. Not customer-visible.",
  "request_schema": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "type": "object",
    "required": ["customer_id", "update"],
    "properties": {
      "customer_id": { "type": "string" },
      "update": { "type": "object" }
    },
    "additionalProperties": false
  },
  "response_schema": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "type": "object",
    "required": ["ok"],
    "properties": { "ok": { "type": "boolean" } },
    "additionalProperties": true
  },
  "errors": ["INVALID_INPUT", "FORBIDDEN", "RATE_LIMITED"]
}

