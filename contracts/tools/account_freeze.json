{
  "version": 1,
  "name": "account_freeze",
  "description": "Controlled-write request to apply a temporary freeze/hold to a customer account under fraud policy and approvals.",
  "request_schema": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "type": "object",
    "required": ["customer_id", "reason"],
    "properties": {
      "customer_id": { "type": "string" },
      "reason": { "type": "string", "minLength": 1 },
      "scope": { "type": "string", "enum": ["transfers", "withdrawals", "all"], "default": "all" }
    },
    "additionalProperties": false
  },
  "response_schema": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "type": "object",
    "required": ["ok"],
    "properties": {
      "ok": { "type": "boolean" },
      "request_id": { "type": "string" },
      "status": { "type": "string", "enum": ["submitted", "queued_for_review", "applied"] }
    },
    "additionalProperties": true
  },
  "errors": ["INVALID_INPUT", "FORBIDDEN", "CONFLICT", "RATE_LIMITED"]
}

