{
  "version": 1,
  "name": "notification_send",
  "description": "Controlled-write send onboarding reminder/help message via approved channels.",
  "request_schema": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "type": "object",
    "required": ["customer_id", "channel", "message"],
    "properties": {
      "customer_id": { "type": "string" },
      "channel": { "type": "string", "enum": ["in_app", "email", "sms", "whatsapp"] },
      "message": { "type": "string", "minLength": 1 },
      "template_id": { "type": "string" }
    },
    "additionalProperties": false
  },
  "response_schema": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "type": "object",
    "required": ["ok"],
    "properties": { "ok": { "type": "boolean" } },
    "additionalProperties": true
  },
  "errors": ["INVALID_INPUT", "FORBIDDEN", "RATE_LIMITED", "UPSTREAM_UNAVAILABLE"]
}

