{
  "version": 1,
  "name": "fetch_payment_trace",
  "description": "Read-only trace of provider/bank processing state for a transaction. Sanitized, no internal IDs.",
  "request_schema": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "type": "object",
    "required": ["transaction_id"],
    "properties": {
      "transaction_id": { "type": "string" }
    },
    "additionalProperties": false
  },
  "response_schema": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "type": "object",
    "required": ["transaction_id", "trace_status"],
    "properties": {
      "transaction_id": { "type": "string" },
      "trace_status": { "type": "string", "enum": ["not_available", "in_progress", "confirmed", "failed"] },
      "provider_status": { "type": "string" },
      "last_updated_at": { "type": "string", "format": "date-time" },
      "notes": { "type": "string" }
    },
    "additionalProperties": true
  },
  "errors": ["INVALID_INPUT", "NOT_FOUND", "FORBIDDEN", "UPSTREAM_TIMEOUT", "UPSTREAM_UNAVAILABLE"]
}

